		"_exporter_id": "31129478",
		"_collection_link": "https://tyy000.postman.co/workspace/QA-Technical-Pro~108d72bd-f50e-4ffc-bb7e-24b2bb026920/collection/31129478-6ed9be57-c93f-41fa-9216-fdb4c8e6b156?action=share&source=collection_link&creator=31129478"
	},
	"item": [
		{
			"name": "IsValidISBN13",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const body = pm.response.text();",
							"",
							"//  Check response status code",
							"pm.test(\"Response status is 200\", () => {",
							"    pm.expect(pm.response.code).to.eql(200);",
							"});",
							"",
							"//  Check that response type is XML",
							"pm.test(\"Response Content-Type is XML\", () => {",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"xml\");",
							"});",
							"",
							"//  Response body is not empty",
							"pm.test(\"Response body is not empty\", () => {",
							"    pm.expect(body).to.not.be.empty;",
							"});",
							"",
							"//  SOAP Body is not empty",
							"pm.test(\"SOAP Body is not empty\", () => {",
							"    pm.expect(body).to.match(/<soap:Body>[\\s\\S]+<\\/soap:Body>/);",
							"});",
							"",
							"//  XML version is correct",
							"pm.test(\"XML version is 1.0\", () => {",
							"    pm.expect(body).to.include('<?xml version=\"1.0\" encoding=\"utf-8\"?>');",
							"});",
							"",
							"",
							"",
							"//  Check result tag and boolean value",
							"pm.test(\"Result tag is boolean\", () => {",
							"    pm.expect(body).to.match(/<m:IsValidISBN13Result>(true|false)<\\/m:IsValidISBN13Result>/);",
							"});",
							"",
							"//  Check expected tags in SOAP response",
							"pm.test(\"All key XML tags are present\", () => {",
							"    const expectedTags = [",
							"        \"soap:Envelope\",",
							"        \"soap:Body\",",
							"        \"m:IsValidISBN13Response\",",
							"        \"m:IsValidISBN13Result\"",
							"    ];",
							"    expectedTags.forEach(tag => pm.expect(body).to.include(tag));",
							"});",
							"",
							"",
							"",
							"pm.test(\"Check ISBN13 result based on request ISBN\", () => {",
							"    // Берём ISBN из переменной запроса",
							"    const isbn = pm.variables.get(\"isbn\"); ",
							"",
							"    const body = pm.response.text();",
							"    const resultMatch = body.match(/<m:IsValidISBN13Result>(true|false)<\\/m:IsValidISBN13Result>/);",
							"    const result = resultMatch ? resultMatch[1] : null;",
							"",
							"    if (isbn === \"978-1-4612-9090-2\") {",
							"        pm.expect(result).to.eql(\"true\");",
							"    } else {",
							"        pm.expect(result).to.eql(\"false\");",
							"    }",
							"});",
							"",
							"pm.test(\"SOAP Envelope is present with correct namespace\", () => {",
							"   pm.expect(body).to.include('<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">');",
							"});",
							"",
							"pm.test(\"All XML tags are closed\", () => {",
							"   // Считаем открывающие теги (не включая <?xml ... ?> )",
							"    const openTags = (body.match(/<[^\\/!?][^>]*>/g) || []).length;",
							"",
							"    // Считаем закрывающие теги",
							"    const closeTags = (body.match(/<\\/[^>]+>/g) || []).length;",
							"",
							"    pm.expect(openTags, \"Number of opening and closing tags mismatch\").to.eql(closeTags);",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.variables.set(\"isbn\", \"978-1-4612-9090-2\"); ",
							"//pm.variables.set(\"isbn\", \"978-1-4612-9090-1\");",
							"//pm.variables.set(\"isbn\", \"\");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8"
					},
					{
						"key": "SOAPAction",
						"value": "http://webservices.daehosting.com/ISBN/IsValidISBN13"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				}
			},
			"response": []
		},
